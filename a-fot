function run_cfgo_flow() {
  local stage_ids=(
    "01-build-raw"
    "02-run-raw"
    "03-build-cfgo-pgo"
    "04-run-cfgo-pgo"
    "05-build-cfgo-cspgo"
    "06-run-cfgo-cspgo"
    "07-bolt-instrument"
    "08-run-bolt"
    "09-bolt-optimize"
  )
  local stage_titles=(
    "原始构建"
    "原始运行"
    "CFGO-PGO 构建"
    "CFGO-PGO 运行"
    "CFGO-CSPGO 构建"
    "CFGO-CSPGO 运行"
    "BOLT 插桩"
    "BOLT 插桩运行"
    "BOLT 优化"
  )
  local stage_funcs=(
    "cfgo_stage_build_raw"
    "cfgo_stage_run_raw"
    "cfgo_stage_build_pgo"
    "cfgo_stage_run_pgo"
    "cfgo_stage_build_cspgo"
    "cfgo_stage_run_cspgo"
    "cfgo_stage_bolt_instrument"
    "cfgo_stage_run_bolt"
    "cfgo_stage_bolt_optimize"
  )
  local effective_start="${start_substage:-01-build-raw}"
  local start_index
  local idx

  start_index=$(cfgo_substage_index "${effective_start}")
  cfgo_effective_start_substage="${effective_start}"
  log_status "执行计划 | AutoCFGO 从 ${cfgo_effective_start_substage} 开始 | 共 ${#stage_ids[@]} 个子阶段"
  write_summary

  for idx in "${!stage_ids[@]}"; do
    if [[ "$idx" -lt "$start_index" ]]; then
      mark_substage_skipped "${stage_ids[$idx]}" "${stage_titles[$idx]}" "配置要求从 ${cfgo_effective_start_substage} 开始执行。"
      log_status "阶段跳过 | ${stage_titles[$idx]} | 原因=从 ${cfgo_effective_start_substage} 起跑"
      continue
    fi
    run_substage "${stage_ids[$idx]}" "${stage_titles[$idx]}" "${stage_funcs[$idx]}"
  done
}

function dump_file_to_logs() {
  local title="$1"
  local file_path="$2"
  local detail_mode="${A_FOT_VERBOSE_WRAPPER:-$verbose_mode}"
  if [[ ! -f "$file_path" ]]; then
    return
  fi

  if [[ "$detail_mode" == "1" ]]; then
    if [[ "${verbose_mode}" == "1" ]]; then
      printf '\n===== %s: %s =====\n' "$title" "$file_path"
      cat "$file_path"
      printf '\n===== END %s =====\n' "$title"
    fi
    {
      printf '\n===== %s: %s =====\n' "$title" "$file_path"
      cat "$file_path"
      printf '\n===== END %s =====\n' "$title"
    } >>"$log_file"
    if [[ -n "$current_substage_log" ]]; then
      {
        printf '\n===== %s: %s =====\n' "$title" "$file_path"
        cat "$file_path"
        printf '\n===== END %s =====\n' "$title"
      } >>"$current_substage_log"
    fi
  else
    log_info "${title} 已生成：${file_path}（默认不展开全文；如需完整内容可设置 A_FOT_VERBOSE_WRAPPER=1）"
  fi
}

function analyze_compile_trace() {
  local stage_id="$1"
  shift

  if [[ "$build_mode" != "Wrapper" ]]; then
    compile_trace_mode_note="当前构建模式为 Bear，未启用精确 wrapper trace 校验。"
    compile_trace_reports["$stage_id"]="构建模式为 Bear，跳过精确命中校验。"
    write_summary
    return 0
  fi

  compile_trace_mode_note="当前构建模式为 Wrapper，已启用精确 wrapper trace 校验。"

  if [[ ! -f "$compile_trace_file" ]]; then
    compile_trace_reports["$stage_id"]="trace文件不存在：${compile_trace_file}"
    write_summary
    if [[ "${check_success}" -eq 1 ]]; then
      fail_stage "optimization_flow" 1 "未找到编译 trace 文件：${compile_trace_file}" "请检查构建脚本是否通过 wrapper 调用编译器。"
    fi
    return 0
  fi

  local stage_lines total_count report marker count sample line
  stage_lines=$(grep "stage=${stage_id} " "$compile_trace_file" || true)
  total_count=$(printf '%s\n' "$stage_lines" | sed '/^$/d' | wc -l)
  report="trace文件=${compile_trace_file}"$'\n'"本阶段记录条数=${total_count}"

  for marker in "$@"; do
    count=$(printf '%s\n' "$stage_lines" | grep -c -- "$marker" || true)
    sample=$(printf '%s\n' "$stage_lines" | grep -- "$marker" | head -n 1 || true)
    report+=$'\n'"marker=${marker} 命中次数=${count}"
    if [[ -n "$sample" ]]; then
      report+=$'\n'"首次命中=${sample}"
    fi
    if [[ "${check_success}" -eq 1 && "$count" -eq 0 ]]; then
      compile_trace_reports["$stage_id"]="$report"
      write_summary
      fail_stage "optimization_flow" 1 "子阶段 ${stage_id} 未命中期望编译参数：${marker}" "可能是构建脚本未使用 CC/CXX、绕过 wrapper，或构建阶段过短。"
    fi
  done

  compile_trace_reports["$stage_id"]="$report"
  while IFS= read -r line; do
    [[ -n "$line" ]] && log_info "[Trace:${stage_id}] $line"
  done <<<"$report"
  write_summary
}

# 根据模式加载不同的优化脚本
function load_script() {
  case "${opt_mode}" in
  "AutoFDO")
    source "${afot_path}/auto_fdo.sh"
    ;;
  "AutoBOLT")
    source "${afot_path}/auto_bolt.sh"
    ;;
  "AutoPGO")
    source "${afot_path}/auto_pgo.sh"
    ;;
  "AutoCFGO")
    source "${afot_path}/auto_cfgo.sh"
    ;;
  *)
    fail_stage "load_script" 1 "Optimization mode '${opt_mode}' is not supported." "Check the 'opt_mode' configuration item."
    ;;
  esac
}

# 公共依赖检查项
function check_common_dependency() {
  local get_arch
  get_arch=$(arch)
  if [[ "${get_arch}" =~ "x86_64" || "${get_arch}" =~ "aarch64" ]]; then
    log_info "Current arch: ${get_arch}"
  else
    fail_stage "check_dependency" 1 "Unsupported arch: ${get_arch}" "Use x86_64 or aarch64."
  fi
  if ! command -v perf >/dev/null 2>&1; then
    fail_stage "check_dependency" 1 "Optimization mode ${opt_mode} requires perf, but it is missing." "Try 'yum install perf'."
  fi
  is_file_exist "${build_script}" "build_script" "file"
  is_file_exist "${run_script}" "run_script" "file"
  case "${compiler}" in
  "gcc")
    is_file_exist "${compiler_path}/bin/gcc" "compiler_path" "executable"
    ;;
  "llvm")
    is_file_exist "${compiler_path}/bin/clang" "compiler_path" "executable"
    ;;
  *)
    fail_stage "check_dependency" 1 "compiler '${compiler}' is not supported." "Check the 'compiler' configuration item."
    ;;
  esac
}

# 拆分编译数据库
function split_option() {
  if [[ -n "$bear_prefix" ]]; then
    python3 "$afot_path/split_json.py" -i "$PWD/compile_commands.json"
    mv "$PWD/compile_commands.json" "$PWD/compile_commands_$1.json"
    mv "$PWD/compile_commands.fail.json" "$PWD/compile_commands.fail_$1.json"
  fi
}

# 使用原始编译选项进行编译
function first_compilation() {
  local stage_log
  local -a cmd
  stage_log=$(get_active_log_file)
  log_status "开始原始构建 | 输入脚本=${build_script} | 日志=${stage_log}"
  is_file_exist "${build_script}" "build_script" "file"
  if [[ "${build_mode}" =~ "Bear" ]]; then
    bear_prefix="bear -- "
    log_info "当前使用 Bear 构建模式。"
    cmd=(bear -- bash -x "${build_script}")
  else
    bear_prefix=""
    log_info "当前使用 Wrapper 构建模式。"
    cmd=(bash -x "${build_script}")
  fi
  run_logged_command "原始构建" "${stage_log}" "${cmd[@]}"
  local build_result=$?
  split_option first
  is_success "${build_result}" "原始构建失败。" "请查看阶段日志：${stage_log}"
  is_file_exist "${bin_file}" "bin_file" "file"
  record_substage_artifact "构建产物：${bin_file}"
}

# 创建wrapper之后的操作
function post_create_wrapper() {
  chmod 755 "${compiler_wrapper}/${c_compiler}"
  chmod 755 "${compiler_wrapper}/${cxx_compiler}"

  export CC="${compiler_wrapper}/${c_compiler}"
  export CXX="${compiler_wrapper}/${cxx_compiler}"
  if [[ "$compiler" == "gcc" ]]; then
    export LD_LIBRARY_PATH="${compiler_path}/lib64:${LD_LIBRARY_PATH}"
  else
    export LD_LIBRARY_PATH="${compiler_path}/lib:${LD_LIBRARY_PATH}"
  fi

  export PATH="${compiler_wrapper}:${PATH}"
}

# 执行应用程序执行脚本
function execute_run_script() {
  local stage_log
  local process_id
  stage_log=$(get_active_log_file)
  log_status "开始运行阶段 | 脚本=${run_script} | 目标进程=${application_name} | 日志=${stage_log}"
  process_id=$(pidof "${application_name}" 2>/dev/null || true)
  if [[ -n "${process_id}" ]]; then
    fail_stage "optimization_flow" 1 "目标进程 '${application_name}' 已存在（PID: ${process_id}）。" "请先停止已有进程，再重新执行 A-FOT。"
  fi
  is_file_exist "${run_script}" "run_script" "file"
  log_info "运行脚本启动时间：$(date '+%Y-%m-%d %H:%M:%S')"
  /bin/bash -x "${run_script}" >>"${stage_log}" 2>&1 &
  run_script_pid=$!
  log_info "运行脚本后台PID：${run_script_pid}"
  is_success "$?" "启动运行脚本 '${run_script}' 失败。" "请检查脚本路径、权限和脚本内容。"
}

# 探测应用进程是否存在
function detect_process() {
  local detect_time=0
  local wait_log_interval=10
  local pids=()
  local remaining_pids=()
  local pid

  log_status "开始探测目标进程 | name=${application_name} | 超时=${max_waiting_time}s"

  while true; do
    pids=($(pgrep -x "${application_name}" || true))

    if [[ ${#pids[@]} -gt 0 ]]; then
      log_status "目标进程已启动 | name=${application_name} | PID=${pids[*]} | 启动耗时=$(format_duration "$detect_time")"
      break
    fi

    sleep 1
    ((detect_time++))
    if [[ ${detect_time} -eq 1 || $((detect_time % wait_log_interval)) -eq 0 ]]; then
      log_status "等待 ${application_name} 启动 | $(format_duration "$detect_time")/$(format_duration "${max_waiting_time}")"
    fi

    if [[ ${detect_time} -gt ${max_waiting_time} ]]; then
      fail_stage "optimization_flow" 1 "在 ${max_waiting_time}s 内未找到目标进程 ${application_name}。" "请检查 run_script 是否启动了正确的目标进程名。"
    fi
  done

  if [[ "${opt_mode}" != "AutoCFGO" ]]; then
    return
  fi

  log_status "开始等待 workload 结束 | 目标进程=${application_name}"
  detect_time=0

  while [[ ${#pids[@]} -gt 0 ]]; do
    remaining_pids=()
    for pid in "${pids[@]}"; do
      if ps -p "${pid}" >/dev/null; then
        remaining_pids+=("${pid}")
      fi
    done

    pids=("${remaining_pids[@]}")

    if [[ ${#pids[@]} -eq 0 ]]; then
      break
    fi

    sleep 1
    ((detect_time++))

    if [[ $((detect_time % 60)) -eq 0 ]]; then
      log_status "等待 ${application_name} 退出 | $(format_duration "$detect_time")/$(format_duration "${max_waiting_time}") | 在运行PID=${pids[*]}"
    fi

    if [[ ${detect_time} -gt ${max_waiting_time} ]]; then
      fail_stage "optimization_flow" 1 "进程 ${application_name} 未在 ${max_waiting_time}s 内全部退出。" "请检查 workload 是否正常结束。"
    fi
  done

  log_status "workload 已结束 | 目标进程=${application_name} | 等待耗时=$(format_duration "$detect_time")"
}

# 使用新的编译选项编译，同时判断优化结果.
# 需注意此检查依赖wrapper中编译器后添加第一个编译选项，
# 因此需保证编译器后添加第一个编译选项为优化选项而非通用选项
function second_compilation() {
  local stage_log
  local -a cmd
  stage_log=$(get_active_log_file)
  log_status "开始优化构建 | 输入脚本=${build_script} | 日志=${stage_log}"
  if [[ "${build_mode}" =~ "Bear" ]]; then
    bear_prefix="bear -- "
    cmd=(bear -- /bin/bash -x "${build_script}")
  else
    bear_prefix=""
    cmd=(/bin/bash -x "${build_script}")
  fi
  run_logged_command "优化构建" "${stage_log}" "${cmd[@]}"
  local build_result=$?
  log_info "新的编译选项构建结束。"
  is_success "${build_result}" "使用优化选项构建失败。" "请查看阶段日志：${stage_log}"
  is_file_exist "${bin_file}" "bin_file" "file"
  split_option second
  record_substage_artifact "构建产物：${bin_file}"
}

function is_success() {
  local pre_result="$1"
  local message="${2:-Execution failed.}"
  local hint="${3:-Please check the log for details.}"
  if [[ "${pre_result}" -ne 0 ]]; then
    fail_stage "${current_stage}" "${pre_result}" "${message}" "${hint}"
  fi
}

function is_file_exist() {
  local path="$1"
  local config_item="$2"
  local expected_type="${3:-file}"

  case "${expected_type}" in
  file)
    if [[ ! -e "${path}" ]]; then
      fail_stage "${current_stage}" 1 "Required file '${path}' does not exist (config: ${config_item})." "Check the '${config_item}' configuration item."
    fi
    if [[ ! -f "${path}" ]]; then
      fail_stage "${current_stage}" 1 "Path '${path}' is not a regular file (config: ${config_item})." "Check the '${config_item}' configuration item."
    fi
    ;;
  directory)
    if [[ ! -e "${path}" ]]; then
      fail_stage "${current_stage}" 1 "Required directory '${path}' does not exist (config: ${config_item})." "Check the '${config_item}' configuration item."
    fi
    if [[ ! -d "${path}" ]]; then
      fail_stage "${current_stage}" 1 "Path '${path}' is not a directory (config: ${config_item})." "Check the '${config_item}' configuration item."
    fi
    ;;
  executable)
    if [[ ! -e "${path}" ]]; then
      fail_stage "${current_stage}" 1 "Required executable '${path}' does not exist (config: ${config_item})." "Check the '${config_item}' configuration item."
    fi
    if [[ ! -f "${path}" ]]; then
      fail_stage "${current_stage}" 1 "Path '${path}' is not a regular file (config: ${config_item})." "Check the '${config_item}' configuration item."
    fi
    if [[ ! -x "${path}" ]]; then
      fail_stage "${current_stage}" 1 "Path '${path}' is not executable (config: ${config_item})." "Check file permissions or the '${config_item}' configuration item."
    fi
    ;;
  *)
    fail_stage "${current_stage}" 1 "Unsupported file check type '${expected_type}'." "Use file, directory, or executable."
    ;;
  esac
}

#初始化profile文件夹和log文件
function init_profile_and_log() {
  now_time=$(date '+%Y%m%d-%H%M%S')
  profile_data_path="${work_path}/${now_time}"
  log_file="${profile_data_path}/opt.log"
  summary_file="${profile_data_path}/run-summary.txt"
  logs_dir="${profile_data_path}/logs"
  artifacts_dir="${profile_data_path}/artifacts"
  wrappers_dir="${profile_data_path}/wrappers"
  profiles_dir="${profile_data_path}/profiles"
  compile_trace_file="${artifacts_dir}/compile.trace"

  if [[ ! -d "${profile_data_path}" ]]; then
    mkdir -p "${profile_data_path}" || fail_stage "init_runtime" 1 "Failed to create profile directory '${profile_data_path}'." "Check that work_path='${work_path}' exists and is writable."
  fi

  mkdir -p "${logs_dir}" "${artifacts_dir}" "${wrappers_dir}" "${profiles_dir}" || fail_stage "init_runtime" 1 "无法初始化日志、产物、wrapper 或 profile 目录。" "请检查工作目录权限。"
  touch "${log_file}" || fail_stage "init_runtime" 1 "Failed to initialize log file '${log_file}'." "Check directory permissions for '${profile_data_path}'."
  touch "${summary_file}" || fail_stage "init_runtime" 1 "Failed to initialize summary file '${summary_file}'." "Check directory permissions for '${profile_data_path}'."
  : >"${compile_trace_file}" || fail_stage "init_runtime" 1 "无法初始化编译 trace 文件 '${compile_trace_file}'。" "请检查目录权限。"

  log_status "创建运行目录：${profile_data_path}"
  log_info "初始化主日志：${log_file}"

  if [[ "$compiler" == "gcc" ]]; then
    c_compiler="gcc"
    cxx_compiler="g++"
    export LD_LIBRARY_PATH="${compiler_path}/lib64:${LD_LIBRARY_PATH}"
  else
    c_compiler="clang"
    cxx_compiler="clang++"
    export LD_LIBRARY_PATH="${compiler_path}/lib:${LD_LIBRARY_PATH}"
  fi

  compiler_wrapper="${wrappers_dir}/current"
  mkdir -p "${compiler_wrapper}" || fail_stage "init_runtime" 1 "Failed to create compiler wrapper directory '${compiler_wrapper}'." "Check directory permissions for '${profile_data_path}'."
  log_runtime_paths
  write_summary
}


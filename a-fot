    printf '%s' "$log_file"
  fi
}

function set_stage_log() {
  local stage_id="$1"
  current_substage_log="${logs_dir}/${stage_id}.log"
  substage_log["$stage_id"]="$current_substage_log"
}

function cfgo_substage_default_title() {
  case "$1" in
  "01-build-raw") printf '%s' "原始构建" ;;
  "02-run-raw") printf '%s' "原始运行" ;;
  "03-build-cfgo-pgo") printf '%s' "CFGO-PGO 构建" ;;
  "04-run-cfgo-pgo") printf '%s' "CFGO-PGO 运行" ;;
  "05-build-cfgo-cspgo") printf '%s' "CFGO-CSPGO 构建" ;;
  "06-run-cfgo-cspgo") printf '%s' "CFGO-CSPGO 运行" ;;
  "07-bolt-instrument") printf '%s' "BOLT 插桩" ;;
  "08-run-bolt") printf '%s' "BOLT 插桩运行" ;;
  "09-bolt-optimize") printf '%s' "BOLT 优化" ;;
  *) printf '%s' "未命名阶段" ;;
  esac
}

function cfgo_substage_index() {
  local target="$1"
  local idx
  for idx in "${!cfgo_substages[@]}"; do
    if [[ "${cfgo_substages[$idx]}" == "$target" ]]; then
      printf '%s' "$idx"
      return 0
    fi
  done
  printf '%s' "-1"
}

function cfgo_progress_message() {
  local stage_id="$1"
  local current_index=0
  local total_count="${#cfgo_substages[@]}"
  local idx
  for idx in "${!cfgo_substages[@]}"; do
    if [[ "${cfgo_substages[$idx]}" == "$stage_id" ]]; then
      current_index=$((idx + 1))
      break
    fi
  done

  if [[ $current_index -eq 0 ]]; then
    printf '进度：[?????????] 未知阶段 %s' "$stage_id"
    return
  fi

  local filled=$current_index
  local empty=$((total_count - filled))
  local bar
  bar=$(printf '%0.s#' $(seq 1 "$filled"))
  if [[ $empty -gt 0 ]]; then
    bar+=$(printf '%0.s-' $(seq 1 "$empty"))
  fi
  printf '进度：[%s] %d/%d' "$bar" "$current_index" "$total_count"
}

function log_runtime_paths() {
  log_status "运行目录就绪 | 运行目录=${profile_data_path} | 主日志=${log_file} | Summary=${summary_file}"
  log_info "输出归档：logs=${logs_dir} | artifacts=${artifacts_dir} | profiles=${profiles_dir}"
  log_info "编译注入：trace=${compile_trace_file} | wrappers=${compiler_wrapper}"
  if [[ -n "${cfgo_effective_start_substage:-}" ]]; then
    log_info "CFGO 起跑阶段：${cfgo_effective_start_substage}"
  fi
}

function start_substage() {
  local stage_id="$1"
  local title="$2"
  local progress focus
  current_substage="$stage_id"
  current_substage_title="$title"
  substage_title["$stage_id"]="$title"
  substage_status["$stage_id"]="运行中"
  substage_start["$stage_id"]="$(date '+%Y-%m-%d %H:%M:%S')"
  substage_end["$stage_id"]=""
  substage_duration["$stage_id"]=""
  set_stage_log "$stage_id"
  : >"$current_substage_log"
  {
    printf '阶段ID: %s\n' "$stage_id"
    printf '阶段标题: %s\n' "$title"
    printf '开始时间: %s\n\n' "${substage_start[$stage_id]}"
  } >>"$current_substage_log"
  progress=$(cfgo_progress_message "$stage_id")
  focus=$(detect_focus_for_stage "$stage_id")
  substage_focus["$stage_id"]="$focus"
  log_status "阶段开始 | ${progress} | ${title} | stage=${stage_id}"
  log_info "阶段焦点：${focus}"
  log_info "阶段日志：${current_substage_log}"
  write_summary
}

function finish_substage() {
  local stage_id="$1"
  local start_epoch end_epoch end_value duration_seconds progress
  end_value=$(date '+%Y-%m-%d %H:%M:%S')
  substage_end["$stage_id"]="$end_value"
  if [[ -n "${substage_start[$stage_id]}" ]]; then
    start_epoch=$(date -d "${substage_start[$stage_id]}" +%s 2>/dev/null || echo "")
    end_epoch=$(date -d "$end_value" +%s 2>/dev/null || echo "")
    if [[ -n "$start_epoch" && -n "$end_epoch" ]]; then
      duration_seconds=$((end_epoch - start_epoch))
      substage_duration["$stage_id"]="$(format_duration "$duration_seconds")"
    fi
  fi
  substage_status["$stage_id"]="成功"
  progress=$(cfgo_progress_message "$stage_id")
  log_status "阶段完成 | ${progress} | ${substage_title[$stage_id]} | 耗时=${substage_duration[$stage_id]:-N/A} | 产物=$(summarize_artifacts_inline "$stage_id")"
  current_substage=""
  current_substage_title=""
  current_substage_log=""
  write_summary
}

function mark_substage_skipped() {
  local stage_id="$1"
  local title="$2"
  local reason="$3"
  substage_title["$stage_id"]="$title"
  substage_status["$stage_id"]="已跳过"
  substage_log["$stage_id"]="N/A"
  substage_start["$stage_id"]=""
  substage_end["$stage_id"]=""
  substage_duration["$stage_id"]=""
  substage_focus["$stage_id"]="跳过"
  substage_artifacts["$stage_id"]="跳过原因：${reason}"
  write_summary
}

function record_substage_artifact() {
  local message="$1"
  local stage_id="${current_substage:-}"
  if [[ -z "$stage_id" ]]; then
    return
  fi
  if [[ -n "${substage_artifacts[$stage_id]}" ]]; then
    substage_artifacts["$stage_id"]+=$'\n'
  fi
  substage_artifacts["$stage_id"]+="$message"
}

function run_substage() {
  local stage_id="$1"
  local title="$2"
  shift 2
  start_substage "$stage_id" "$title"
  "$@"
  local rc=$?
  if [[ $rc -ne 0 ]]; then
    fail_stage "optimization_flow" "$rc" "子阶段 '${stage_id}' 执行失败。" "请查看阶段日志：${current_substage_log}"
  fi
  finish_substage "$stage_id"
}

function append_log() {
  local level="$1"
  local message="$2"
  local line
  line=$(printf '[%s] [%s] %s' "$(date '+%Y-%m-%d %H:%M:%S')" "$level" "$message")
  if should_print_to_stdout "$level" "$message"; then
    echo "$line"
  fi
  if [[ -n "$log_file" ]]; then
    printf '%s\n' "$line" >>"$log_file"
  fi
  if [[ -n "$current_substage_log" && "$current_substage_log" != "$log_file" ]]; then
    printf '%s\n' "$line" >>"$current_substage_log"
  fi
}

function should_print_to_stdout() {
  local level="$1"
  local message="$2"

  if [[ "${verbose_mode}" == "1" ]]; then
    return 0
  fi

  case "$level" in
  ERROR | WARNING)
    return 0
    ;;
  STATUS)
    case "$message" in
    "执行计划"* | "阶段开始"* | "阶段完成"* | "阶段失败"* | "阶段跳过"* | "开始原始构建"* | "开始优化构建"* | "开始运行阶段"* | *"进行中 | 已运行 "* | "等待 "*"启动"* | "目标进程已启动"* | "开始等待 workload 结束"* | "等待 "*"退出"* | "workload 已结束"* | "优化流程执行完成。" )
      return 0
      ;;
    *)
      return 1
      ;;
    esac
    ;;
  *)
    return 1
    ;;
  esac
}

function log_info() {
  append_log "INFO" "$1"
}

function log_status() {
  append_log "STATUS" "$1"
}

function log_warn() {
  append_log "WARNING" "$1"
}

function log_error() {
  append_log "ERROR" "$1"
}

function collect_failure_excerpt() {
  local target_log="$1"
  if [[ -z "$target_log" || ! -f "$target_log" ]]; then
    failure_log_excerpt=""
    return
  fi

  failure_log_excerpt=$(tail -n 120 "$target_log" | grep -E "error:|undefined reference|CMake Error|make(\[[0-9]+\])?: \*\*\*|FAILED:|No rule to make target|collect2: error|fatal error:" | tail -n 12 || true)
  if [[ -z "$failure_log_excerpt" ]]; then
    failure_log_excerpt=$(tail -n 20 "$target_log" || true)
  fi
}

function log_failure_excerpt() {
  local line
  [[ -z "${failure_log_excerpt:-}" ]] && return
  log_error "失败摘要："
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    log_error "  ${line}"
  done <<<"${failure_log_excerpt}"
}

function run_logged_command() {
  local task_label="$1"
  local stage_log="$2"
  shift 2

  "$@" >>"${stage_log}" 2>&1 &
  local cmd_pid=$!
  local elapsed=0

  while kill -0 "$cmd_pid" 2>/dev/null; do
    sleep 1
    ((elapsed++))
    if [[ $((elapsed % heartbeat_interval)) -eq 0 ]]; then
      log_status "${task_label}进行中 | 已运行 $(format_duration "$elapsed") | 日志持续写入 ${stage_log}"
    fi
  done

  wait "$cmd_pid"
  return $?
}

function write_summary() {
  local total_duration="N/A"
  local active_stage_log="${current_substage_log:-N/A}"
  local key value source stage substage artifact_line report_line excerpt_line

  if [[ -z "$summary_file" ]]; then
    return
  fi

  if [[ -n "${failure_stage:-}" && -n "${substage_log[$failure_stage]:-}" ]]; then
    active_stage_log="${substage_log[$failure_stage]}"
  fi

  if [[ -n "${run_end_epoch:-}" && -n "${run_start_epoch:-}" ]]; then
    total_duration=$(format_duration "$((run_end_epoch - run_start_epoch))")
  elif [[ -n "${run_start_epoch:-}" ]]; then
    total_duration=$(format_duration "$(( $(date +%s) - run_start_epoch ))")
  fi

  {
    printf '运行结论:\n'
    printf '  结果: %s\n' "${run_status:-运行中}"
    printf '  当前模式: %s\n' "${opt_mode:-N/A}"
    printf '  失败/停留阶段: %s\n' "${failure_stage:-${current_substage:-N/A}}"
    printf '  直接原因: %s\n' "${failure_message:-N/A}"
    printf '  建议动作: %s\n' "${failure_hint:-N/A}"
    printf '  总耗时: %s\n' "${total_duration}"
    printf '  主日志: %s\n' "${log_file:-N/A}"
    printf '  当前阶段日志: %s\n' "${active_stage_log:-N/A}"
    if [[ -n "${failure_log_excerpt:-}" ]]; then
      printf '  最近错误摘要:\n'
      while IFS= read -r excerpt_line; do
        [[ -n "$excerpt_line" ]] && printf '    %s\n' "$excerpt_line"
      done <<<"${failure_log_excerpt}"
    fi

    printf '\n运行元信息:\n'
    printf '  运行ID: %s\n' "${run_id:-N/A}"
    printf '  开始时间: %s\n' "${start_time:-N/A}"
    printf '  配置文件: %s\n' "${config_file:-N/A}"
    printf '  CFGO起始子阶段: %s\n' "${cfgo_effective_start_substage:-${start_substage:-01-build-raw}}"

    printf '\n关键配置:\n'
    printf '  build_script=%s\n' "${build_script:-N/A}"
    printf '  run_script=%s\n' "${run_script:-N/A}"
    printf '  bin_file=%s\n' "${bin_file:-N/A}"
    printf '  application_name=%s\n' "${application_name:-N/A}"
    printf '  compiler=%s\n' "${compiler:-N/A}"
    printf '  compiler_path=%s\n' "${compiler_path:-N/A}"
    printf '  build_mode=%s\n' "${build_mode:-N/A}"
    printf '  perf_time=%s\n' "${perf_time:-N/A}"

    printf '\n生效配置:\n'
    for key in "${summary_keys[@]}"; do
      if [[ "$key" == "config_file" ]]; then
        value="$config_file"
      else
        value="${!key}"
      fi
      source="${config_sources[$key]:-unset}"
      printf '  %s=%s (source=%s)\n' "$key" "${value:-<unset>}" "$source"
    done

    printf '\n主阶段状态:\n'
    for stage in "${stage_order[@]}"; do
      printf '  %s: %s\n' "$stage" "${stage_states[$stage]:-PENDING}"
    done

    printf '\n子阶段概览:\n'
    for substage in "${cfgo_substages[@]}"; do
      printf '  %s | %s | 状态=%s | 耗时=%s | 日志=%s\n' \
        "$substage" \
        "${substage_title[$substage]:-未执行}" \
        "${substage_status[$substage]:-未开始}" \
        "${substage_duration[$substage]:-N/A}" \
        "${substage_log[$substage]:-N/A}"
    done

    printf '\n子阶段详情:\n'
    for substage in "${cfgo_substages[@]}"; do
      printf '  %s [%s]\n' "$substage" "${substage_title[$substage]:-未执行}"
      printf '    状态: %s\n' "${substage_status[$substage]:-未开始}"
      printf '    焦点: %s\n' "${substage_focus[$substage]:-N/A}"
      printf '    日志: %s\n' "${substage_log[$substage]:-N/A}"
      printf '    开始: %s\n' "${substage_start[$substage]:-N/A}"
      printf '    结束: %s\n' "${substage_end[$substage]:-N/A}"
      printf '    耗时: %s\n' "${substage_duration[$substage]:-N/A}"
      if [[ -n "${substage_artifacts[$substage]}" ]]; then
        printf '    产物:\n'
        while IFS= read -r artifact_line; do
          printf '      - %s\n' "$artifact_line"
        done <<<"${substage_artifacts[$substage]}"
      fi
    done

    printf '\n编译Trace摘要:\n'
    printf '  模式说明: %s\n' "${compile_trace_mode_note}"
    for substage in "${cfgo_substages[@]}"; do
      if [[ -n "${compile_trace_reports[$substage]}" ]]; then
        printf '  [%s]\n' "$substage"
        while IFS= read -r report_line; do
          printf '    %s\n' "$report_line"
        done <<<"${compile_trace_reports[$substage]}"
      fi
    done

    printf '\n输出路径:\n'
    printf '  runtime=%s\n' "${profile_data_path:-N/A}"
    printf '  logs=%s\n' "${logs_dir:-N/A}"
    printf '  artifacts=%s\n' "${artifacts_dir:-N/A}"
    printf '  wrappers=%s\n' "${wrappers_dir:-N/A}"
    printf '  profiles=%s\n' "${profiles_dir:-N/A}"
    printf '  compiler_wrapper=%s\n' "${compiler_wrapper:-N/A}"
    printf '  compile_trace=%s\n' "${compile_trace_file:-N/A}"
  } >"$summary_file"
}

function fail_stage() {
  local stage="$1"
  local code="$2"
  local message="$3"
  local hint="${4:-请检查配置和日志后重试。}"
  local actual_stage="${current_substage:-$stage}"

  current_stage="$stage"
  run_status="失败"
  run_end_epoch=$(date +%s)
  failure_stage="$actual_stage"
  failure_message="$message"
  failure_hint="$hint"
  mark_stage_failed "$stage"
  if [[ -n "$current_substage" ]]; then
    substage_status["$current_substage"]="失败"
    substage_end["$current_substage"]="$(date '+%Y-%m-%d %H:%M:%S')"
    substage_duration["$current_substage"]="$(calc_duration_between "${substage_start[$current_substage]}" "${substage_end[$current_substage]}")"
  fi
  collect_failure_excerpt "${current_substage_log:-$log_file}"
  write_summary

  log_status "阶段失败 | stage=${actual_stage} | code=${code} | 建议=${hint}"
  log_error "阶段 '${actual_stage}' 执行失败，退出码 ${code}：${message}"
  log_error "主日志：${log_file:-未初始化}"
  if [[ -n "$current_substage_log" ]]; then
    log_error "阶段日志：${current_substage_log}"
  fi
  log_failure_excerpt
  log_error "建议：${hint}"
  exit "$code"
}

function finish_success() {
  run_status="成功"
  run_end_epoch=$(date +%s)
  failure_stage=""
  failure_message="全部阶段执行完成。"
  failure_hint="可查看 run-summary.txt 与 artifacts 目录确认优化结果。"
  failure_log_excerpt=""
  write_summary
  exit 0
}

function init_runtime_context() {
  run_id=$(date '+%Y%m%d-%H%M%S')
  start_time=$(date '+%Y-%m-%d %H:%M:%S')
  run_start_epoch=$(date +%s)
  record_config_source "config_file" "default"
}

function parse_config_file_arg() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
    --config_file)
      if [[ $# -lt 2 ]]; then
        fail_stage "parse_config" 1 "Option '--config_file' requires a value." "Pass an absolute path after --config_file."
      fi
      config_file="$2"
      record_config_source "config_file" "cli"
      shift 2
      ;;
    *)
      shift
      ;;
    esac
  done
}

function set_config_value() {
  local key="$1"
  local value="$2"
  printf -v "$key" '%s' "$value"
}

function parse_config() {
  if [[ ! -f "$config_file" ]]; then
    fail_stage "parse_config" 1 "Could not load config file at '${config_file}'." "Check that the config file path exists and is readable."
  fi

  local line trimmed_line key value line_no=0
  while IFS= read -r line || [[ -n "$line" ]]; do
    ((line_no++))
    trimmed_line=$(trim_whitespace "$line")
    if [[ -z "$trimmed_line" ]] || [[ "$trimmed_line" == \#* ]]; then
      continue
    fi
    if [[ "$trimmed_line" != *"="* ]]; then
      fail_stage "parse_config" 1 "Invalid config line ${line_no}: '${line}'." "Use the 'key=value' format in ${config_file}."
    fi

    key=$(trim_whitespace "${trimmed_line%%=*}")
    value=$(trim_whitespace "${trimmed_line#*=}")

    if [[ -z "$key" ]]; then
      fail_stage "parse_config" 1 "Config line ${line_no} has an empty key: '${line}'." "Provide a valid config key before '='."
    fi

    if [[ "$key" == CONFIG_* ]]; then
      kernel_configs+=("${key}=${value}")
      continue
    fi

    if [[ -z "${allowed_config_keys[$key]}" ]]; then
      fail_stage "parse_config" 1 "Unknown config item '${key}' on line ${line_no}: '${line}'." "Remove the unsupported config item or add a supported key."
    fi

    set_config_value "$key" "$value"
    record_config_source "$key" "config_file"
  done <"$config_file"
}


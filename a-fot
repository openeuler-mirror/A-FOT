function trim_whitespace() {
  local value="$1"
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  printf '%s' "$value"
}

function format_duration() {
  local total_seconds="${1:-0}"
  if [[ -z "$total_seconds" || "$total_seconds" -lt 0 ]]; then
    total_seconds=0
  fi

  local hours=$((total_seconds / 3600))
  local minutes=$(((total_seconds % 3600) / 60))
  local seconds=$((total_seconds % 60))

  if [[ "$hours" -gt 0 ]]; then
    printf '%dh%02dm%02ds' "$hours" "$minutes" "$seconds"
  elif [[ "$minutes" -gt 0 ]]; then
    printf '%dm%02ds' "$minutes" "$seconds"
  else
    printf '%ds' "$seconds"
  fi
}

function calc_duration_between() {
  local start_value="$1"
  local end_value="${2:-$(date '+%Y-%m-%d %H:%M:%S')}"
  local start_epoch end_epoch

  start_epoch=$(date -d "$start_value" +%s 2>/dev/null || echo "")
  end_epoch=$(date -d "$end_value" +%s 2>/dev/null || echo "")

  if [[ -z "$start_epoch" || -z "$end_epoch" ]]; then
    printf '%s' "N/A"
    return
  fi

  format_duration "$((end_epoch - start_epoch))"
}

function summarize_artifacts_inline() {
  local stage_id="$1"
  local artifact_text="${substage_artifacts[$stage_id]:-}"
  local line
  local count=0
  local summary=""

  if [[ -z "$artifact_text" ]]; then
    printf '%s' "无"
    return
  fi

  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    if [[ $count -ge 2 ]]; then
      summary+=", ..."
      break
    fi
    if [[ -n "$summary" ]]; then
      summary+=", "
    fi
    summary+="$line"
    ((count++))
  done <<<"$artifact_text"

  printf '%s' "$summary"
}

function detect_focus_for_stage() {
  local stage_id="$1"
  case "$stage_id" in
  *build* | *instrument*)
    printf '输入脚本=%s | 输出产物=%s' "${build_script:-N/A}" "${bin_file:-N/A}"
    ;;
  *run*)
    printf '运行脚本=%s | 目标进程=%s | 采样时长=%ss' "${run_script:-N/A}" "${application_name:-N/A}" "${perf_time:-N/A}"
    ;;
  *optimize)
    printf '输入二进制=%s | 输出二进制=%s' "${bin_file:-N/A}" "${bin_file:-N/A}"
    ;;
  *)
    printf '构建脚本=%s | 运行脚本=%s' "${build_script:-N/A}" "${run_script:-N/A}"
    ;;
  esac
}

function record_config_source() {
  local key="$1"
  local source="$2"
  config_sources["$key"]="$source"
}


  stage_states["$stage"]="成功"
  write_summary
}

function mark_stage_failed() {
  local stage="$1"
  stage_states["$stage"]="失败"
  write_summary
}

function get_active_log_file() {
  if [[ -n "$current_substage_log" ]]; then
    printf '%s' "$current_substage_log"

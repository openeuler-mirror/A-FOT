function check_item() {
  local value="$1"
  local item_name="$2"
  if [[ -z "$value" ]]; then
    fail_stage "validate_config" 1 "The configuration item '${item_name}' is missing." "Update ${config_file} or provide the matching command line option."
  fi
}

function validate_cfgo_config() {
  check_item "${application_name:-}" "application_name"
  check_item "${bin_file:-}" "bin_file"
  check_item "${work_path:-}" "work_path"
  check_item "${build_script:-}" "build_script"
  check_item "${run_script:-}" "run_script"
  check_item "${max_waiting_time:-}" "max_waiting_time"
  check_item "${opt_mode:-}" "opt_mode"
  check_item "${perf_time:-}" "perf_time"
  check_item "${compiler:-}" "compiler"
  check_item "${compiler_path:-}" "compiler_path"
  check_item "${check_success:-}" "check_success"
  check_item "${build_mode:-}" "build_mode"

  if [[ "$build_mode" != "Wrapper" && "$build_mode" != "Bear" ]]; then
    fail_stage "validate_config" 1 "Invalid build_mode='${build_mode}' for AutoCFGO." "Use 'Wrapper' or 'Bear'."
  fi

  if [[ "$check_success" != "0" && "$check_success" != "1" ]]; then
    fail_stage "validate_config" 1 "Invalid check_success='${check_success}' for AutoCFGO." "Use '0' or '1'."
  fi

  if [[ "$compiler" != "gcc" ]]; then
    fail_stage "validate_config" 1 "AutoCFGO only supports gcc, but compiler='${compiler}'." "Set compiler=gcc in ${config_file} or pass '--compiler gcc'."
  fi

  if [[ -n "${start_substage:-}" ]]; then
    if [[ "$(cfgo_substage_index "${start_substage}")" -lt 0 ]]; then
      fail_stage "validate_config" 1 "Invalid start_substage='${start_substage}' for AutoCFGO." "Use one of: ${cfgo_substages[*]}."
    fi
  fi
}

function check_config_items() {
  case "${opt_mode:-}" in
  "AutoCFGO")
    validate_cfgo_config
    ;;
  *)
    check_item "${application_name:-}" "application_name"
    check_item "${bin_file:-}" "bin_file"
    check_item "${work_path:-}" "work_path"
    check_item "${build_script:-}" "build_script"
    check_item "${run_script:-}" "run_script"
    check_item "${max_waiting_time:-}" "max_waiting_time"
    check_item "${opt_mode:-}" "opt_mode"
    check_item "${perf_time:-}" "perf_time"
    check_item "${compiler:-}" "compiler"
    check_item "${compiler_path:-}" "compiler_path"
    check_item "${check_success:-}" "check_success"
    check_item "${build_mode:-}" "build_mode"
    ;;
  esac
}

